# Reload Plasma to test changes
killall plasmashell; kstart5 plasmashell

# Monitor logs for debugging
journalctl --user -f | grep plasma
```
DEV_EOF

    echo "✓ Development guide created: ~/weather-widget-development.md"
}

# Main installation
main() {
    check_dependencies
    install_base_widget
    install_enhanced_widget
    install_kde_effects
    setup_development
    
    echo ""
    echo "====================================================="
    echo "             🎉 Installation Complete! 🎉           "
    echo "====================================================="
    echo ""
    echo "✅ Installed Components:"
    echo "   • weather-widget-2 (base widget)"
    echo "   • Enhanced Weather Effects Widget"
    echo "   • KDE desktop effects integration"
    echo "   • Development setup guide"
    echo ""
    echo "🚀 Next Steps:"
    echo "   1. Restart Plasma: killall plasmashell; kstart5 plasmashell"
    echo "   2. Add widgets: Right-click → Add Widgets"
    echo "   3. Configure location in widget settings"
    echo "   4. Fork the repo: https://github.com/blackadderkate/weather-widget-2"
    echo "   5. Read: ~/weather-widget-development.md"
    echo ""
    echo "🎨 Available Widgets:"
    echo "   • Weather Widget (original)"
    echo "   • Weather Effects Widget (Martian-themed)"
    echo ""
    echo "⚡ Desktop Effects:"
    echo "   • rain, snow, day/night theming"
    echo "   • Automatic wallpaper changes"
    echo "   • Color scheme integration"
    echo ""
    echo "Happy coding! 🌟"
}

# Run installation
main "$@"
echo ""
echo "To add the widget:"
echo "1. Right-click on desktop or panel"
echo "2. Select 'Add Widgets...'"
echo "3. Search for 'Weather Effects Widget'"
echo "4. Add to your desktop or panel"
echo ""
echo "Widget features:"
echo "- Real-time weather data with beautiful charts"
echo "- Desktop effects (rain, snow, day/night)"
echo "- The Martian inspired UI design"
echo ""
echo "Advanced usage:"
echo "- Configure location in widget settings"
echo "- Enable compositor effects in System Settings > Desktop Effects"
echo "- Use 'qdbus' commands for manual effect control"
